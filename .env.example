# ─────────────────────────────────────────────────────────────────────────────
# FalkorDB Pulse — environment variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel for production.
# ─────────────────────────────────────────────────────────────────────────────

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials)
# Auth.js auto-detects these two names.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# In production set this to your canonical URL, e.g. https://pulse.falkordb.com
# For local dev you can leave it unset (defaults to http://localhost:3000).
# AUTH_URL=https://pulse.falkordb.com

# Only Google accounts on this email domain may sign in.
ALLOWED_EMAIL_DOMAIN=falkordb.com

# --- FalkorDB ----------------------------------------------------------------
# Either provide a full connection URL...
# FALKORDB_URL=falkors://default:password@your-instance.falkordb.cloud:6379
# ...or the individual parts (used when FALKORDB_URL is empty):
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=pulse

# --- Data collection ---------------------------------------------------------
# GitHub personal access token. Needs `repo` scope to read private repos and the
# traffic (views/clones) API; public stats work with a classic read-only token too.
GH_TOKEN=

# Secret that guards the /api/collect endpoint. On Vercel, set CRON_SECRET and the
# platform injects it automatically into scheduled cron requests.
CRON_SECRET=
